# Konfigurasi scanner -- sisi PERANGKAT TARGET. Salin jadi scanner.env, JANGAN commit.
# Load sebelum menjalankan scanner:
#   Linux:   set -a; . scanner/scanner.env; set +a; sudo -E python3 scanner/linux/cis_scanner_linux.py
#   Windows: set nilai yang sama sebagai environment variable (PowerShell: $env:N8N_WEBHOOK_URL="...")

# URL webhook n8n (production URL, bukan /webhook-test/). Wajib.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/geo-threat/scanner-ingest
# Sama dengan N8N_WEBHOOK_SECRET di n8n/.env. Wajib.
N8N_WEBHOOK_SECRET=CHANGE_ME

# Opsional
SCANNER_MAX_RETRIES=3
SCANNER_RETRY_DELAY=5
SCANNER_TIMEOUT=30
# false HANYA untuk lab dengan sertifikat self-signed
SCANNER_VERIFY_TLS=true
# Override IP yang dilaporkan (lab: pakai IP dalam subnet kantor simulasi). Kosong = deteksi otomatis.
SCANNER_SOURCE_IP=
SCANNER_DEVICE_ID=
SCANNER_SPOOL_DIR=
